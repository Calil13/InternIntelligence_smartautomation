# PostgreSQL Database Configuration
DB_URL=jdbc:postgresql://localhost:5432/smart-queue
DB_USERNAME=admin
DB_PASSWORD=admin123

# Google OAuth 2.0 Credentials (from Google Cloud Console -> APIs & Services -> Credentials)
# Authorized redirect URI: http://localhost:8090/login/oauth2/code/google
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Demo mode lets portfolio visitors explore the full UI & Smart Automation without Google Cloud keys
APP_DEMO_MODE_ENABLED=true

# Optional Server Port
SERVER_PORT=8090
